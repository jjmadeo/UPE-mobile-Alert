{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Host=db;Port=5432;Database=mobilealert;Username=mobilealert;Password=mobilealert"
  },
  "Jwt": {
    "Secret": "CHANGE_ME_dev_only_secret_at_least_32_chars_long",
    "Issuer": "mobile-alert-api",
    "ExpirationHours": 720
  },
  "Fcm": {
    "CredentialsPath": "/run/secrets/firebase-service-account.json"
  },
  "AlertRetry": {
    "IntervalSeconds": 10,
    "MaxRetries": 30
  }
}
