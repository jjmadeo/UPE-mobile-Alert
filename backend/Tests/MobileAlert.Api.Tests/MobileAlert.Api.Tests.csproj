<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.11" />
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.4.0" />
    <!-- Fija a la misma versión que usa MobileAlert.Api.csproj — sin esto,
         Testcontainers.PostgreSql (u otra dependencia transitiva) baja una
         versión más vieja de EF Core, y como los tests ahora usan
         AppDbContext directo (ver GetDb en CriticalFlowsTests), el mismatch
         deja de ser un warning (MSB3277) y pasa a ser un error de compilación
         real (CS1705). -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.11" />
    <!-- Solo para los tests unitarios (Unit/) — DB real en memoria, sin
         Postgres ni Testcontainers, para poder probar la lógica de
         servicios sueltos rápido y aislado. Los tests de integración
         (CriticalFlowsTests) siguen usando Testcontainers + Postgres real,
         no esto — ver el comentario en esa clase sobre por qué (jsonb,
         int[] nativos). -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\MobileAlert.Api.csproj" />
  </ItemGroup>

</Project>
